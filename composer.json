{
    "name": "silvershop/colors",
    "description": "Product colours for SilverShop: a hex-swatch colour palette, product-level multi-colour tags, hex-valued colour variations, and a colour facet for the storefront search.",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "silvershop", "ecommerce", "color", "colour", "swatch", "variations"],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-colors/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silverstripe/cms": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "squizlabs/php_codesniffer": "^3.7",
        "silverstripe/sqlite3": "^4",
        "silvershop/search": "dev-main"
    },
    "suggest": {
        "silvershop/search": "Adds a colour facet (with swatches) to the storefront product search."
    },
    "replace": {
        "silvershop/coloredvariations": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/RVXD/silvershop-search.git"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": false
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Colors\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Colors\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
